{
  "name": "ens-l2-gateway",
  "version": "1.0.0",
  "description": "CCIP Read gateway for ENS L2 subdomain resolution",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "build": "bun build ./index.ts --outdir ./dist --target node",
    "dev": "nodemon --watch './**/*.ts' --exec 'bun run build && bun run start'",
    "test": "jest"
  },
  "keywords": [
    "ens",
    "ccip-read",
    "l2",
    "base",
    "gateway",
    "ethereum"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^5.1.0",
    "viem": "^2.16.1"
  },
  "devDependencies": {
    "@types/bun": "^1.2.18",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
